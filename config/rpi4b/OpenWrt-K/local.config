# 本地排除清单（本文件为本地新增，上游无此文件，合并上游时不会产生冲突）
#
# 用途
#   在不修改上游 extpackages.config 与各目标 *.config 的前提下，
#   关闭本地不需要的拓展包与 CONFIG 开关，把"删除式改动"降为"纯新增改动"。
#
# 读取位置
#   build_helper/prepare.py::parse_configs() 出口处，由 build_helper/utils/local_exclude.py 处理。
#   本文件位于 OpenWrt-K/ 子目录，不参与顶层 *.config 拼接，不会被直接写进 .config。
#
# 写法（三种可混用）
#   keys=A,B,C        # 单行多值
#   keys=A            # 同名键可重复出现，值会依次累加 → 推荐一行一项，便于逐项写注释
#   keys=A   # 说明   # 行尾注释：`#` 之前需留空白
#
# 匹配规则
#   extpackages_exclude = extpackages.config 中的 NAME，精确匹配（命中者不克隆、不复制源码）
#   configs_exclude     = 配置符号名，支持 fnmatch 通配（如 CONFIG_PACKAGE_luci-i18n-ddns-zh-*）
#
# 容错
#   文件缺失、键缺失或键留空，都表示"不做任何排除"，行为与上游完全一致。
#   本文件在 x86_64 与 rpi4b 下当前内容一致；某个目标用不到的条目不会被命中，无副作用。

# ============================================================================
# 一、拓展包声明（命中者不克隆、不复制源码，自然也不进固件）
# ============================================================================

# tailscale 组合 —— 组网方案改用 EasyTier（UPSTREAM-CHANGES UC-0001 / UC-0002）
extpackages_exclude=tailscale                    # 本体，上游 [9]
extpackages_exclude=luci-app-tailscale-community # LuCI 界面，上游 [10]

# 旧 DDNS 方案 —— 改用 ddns-go（UC-0003 / UC-0004）
extpackages_exclude=ddns-scripts_aliyun          # 上游 [27]

# qBittorrent 及其构建链 —— 本地整套下线（UC-0006）
extpackages_exclude=luci-app-qbittorrent         # 上游 [28]
extpackages_exclude=qBittorrent-Enhanced-Edition # 上游 [29]
extpackages_exclude=qt6base                      # 上游 [30]
extpackages_exclude=qt6tools                     # 上游 [31]
extpackages_exclude=libdouble-conversion         # 上游 [32]

# 上游 [33] protobuf-compat 特意不排除（UC-0016）：
# prepare.py 会用 immortalwrt/packages 的 netdata 覆盖官方 feed 的同名包，而它的 Makefile 把
# `+protobuf-compat` 与 `PKG_BUILD_DEPENDS:=protobuf-compat/host` 写成必需依赖。一旦排除，
# defconfig 只会打印 "dependency on 'protobuf-compat', which does not exist" 的 WARNING，
# 直到 make package/install 阶段才以 apk "no such package" 报错终止。它自身只依赖
# zlib / libatomic / libstdcpp / protobuf-compat-lite，与 qBittorrent / qt6 链无关，勿再排除。

# passwall / passwall2 / OpenClash —— 改用 xray-core + 自写 nft 规则（UPSTREAM-CHANGES UC-0006 / UC-0007）
extpackages_exclude=luci-app-passwall              # 上游 [12]
extpackages_exclude=openwrt-passwall-packages      # 上游 [13]，xray-core 改从官方 feed 启用
extpackages_exclude=passwall2                      # 上游 [14]
extpackages_exclude=luci-app-openclash             # 上游 [25]
extpackages_exclude=luci-app-adguardhome           # 上游 [17]，改用官方 openwrt/luci 版（UC-0011）

# ============================================================================
# 二、配置开关（命中者从拼接后的配置文本中整行剔除）
# ============================================================================

# tailscale 组合
configs_exclude=CONFIG_PACKAGE_tailscale
configs_exclude=CONFIG_PACKAGE_luci-app-tailscale-community
configs_exclude=CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-cn
configs_exclude=CONFIG_PACKAGE_luci-i18n-tailscale-community-zh-tw

# SmartDNS 组合 —— DNS 分流改用 mosdns（UPSTREAM-CHANGES UC-0013）
# 上游配置文件中的本体 / 界面 / 语言包均原样保留，关闭动作只在这里表达
configs_exclude=CONFIG_PACKAGE_smartdns
configs_exclude=CONFIG_PACKAGE_luci-app-smartdns
configs_exclude=CONFIG_PACKAGE_luci-i18n-smartdns-ja
configs_exclude=CONFIG_PACKAGE_luci-i18n-smartdns-zh-cn
configs_exclude=CONFIG_PACKAGE_luci-i18n-smartdns-zh-tw

# 旧 DDNS 家族（ddns-scripts / luci-app-ddns）
# 注意：这里刻意逐条列出而不用通配，避免误伤本地新增的 luci-i18n-ddns-go-zh-cn
configs_exclude=CONFIG_PACKAGE_ddns-scripts
configs_exclude=CONFIG_PACKAGE_ddns-scripts-cloudflare
configs_exclude=CONFIG_PACKAGE_ddns-scripts-dnspod
configs_exclude=CONFIG_PACKAGE_ddns-scripts-services
configs_exclude=CONFIG_PACKAGE_ddns-scripts_aliyun
configs_exclude=CONFIG_PACKAGE_luci-app-ddns
configs_exclude=CONFIG_PACKAGE_luci-i18n-ddns-ja
configs_exclude=CONFIG_PACKAGE_luci-i18n-ddns-zh-cn
configs_exclude=CONFIG_PACKAGE_luci-i18n-ddns-zh-tw

# qBittorrent 界面与本体
configs_exclude=CONFIG_PACKAGE_luci-app-qbittorrent
configs_exclude=CONFIG_PACKAGE_luci-i18n-qbittorrent-zh-cn
configs_exclude=CONFIG_PACKAGE_qbittorrent-enhanced-edition

# Qt6 运行时（defconfig 为 qBittorrent 推导出的依赖）
configs_exclude=CONFIG_PACKAGE_libQt6Core
configs_exclude=CONFIG_PACKAGE_libQt6Network
configs_exclude=CONFIG_PACKAGE_libQt6Sql
configs_exclude=CONFIG_PACKAGE_libQt6Xml
configs_exclude=CONFIG_PACKAGE_qt6-plugin-libqopensslbackend
configs_exclude=CONFIG_PACKAGE_qt6-plugin-libqsqlite

# 其它推导依赖：libdouble-conversion 属 qt6base；libtorrent / boost 属 qBittorrent
configs_exclude=CONFIG_PACKAGE_libdouble-conversion
configs_exclude=CONFIG_PACKAGE_libtorrent-rasterbar
configs_exclude=CONFIG_PACKAGE_boost
configs_exclude=CONFIG_PACKAGE_boost-program_options
configs_exclude=CONFIG_PACKAGE_boost-system
configs_exclude=CONFIG_boost-compile-visibility-hidden
configs_exclude=CONFIG_boost-static-and-shared-libs
configs_exclude=CONFIG_boost-runtime-shared
configs_exclude=CONFIG_boost-variant-release

# ============================================================================
# 三、passwall / passwall2 / OpenClash 生态（改用 xray-core + 自写 nft 规则）
#     注意：CONFIG_PACKAGE_xray-core 不在此列 —— 它要保留并从官方 feed 启用
# ============================================================================

# 界面与语言包
configs_exclude=CONFIG_PACKAGE_luci-app-passwall
configs_exclude=CONFIG_PACKAGE_luci-app-passwall_*
configs_exclude=CONFIG_PACKAGE_luci-app-passwall2
configs_exclude=CONFIG_PACKAGE_luci-app-passwall2_*
configs_exclude=CONFIG_PACKAGE_luci-app-openclash
configs_exclude=CONFIG_PACKAGE_luci-i18n-passwall-zh-cn
configs_exclude=CONFIG_PACKAGE_luci-i18n-passwall2-zh-cn

# 代理核心与工具（xray-core 已覆盖这些协议）
configs_exclude=CONFIG_PACKAGE_sing-box
configs_exclude=CONFIG_PACKAGE_hysteria
configs_exclude=CONFIG_PACKAGE_naiveproxy
configs_exclude=CONFIG_PACKAGE_brook
configs_exclude=CONFIG_PACKAGE_microsocks
configs_exclude=CONFIG_PACKAGE_simple-obfs
configs_exclude=CONFIG_PACKAGE_shadowsocks-libev-*
configs_exclude=CONFIG_PACKAGE_shadowsocks-rust-*
configs_exclude=CONFIG_PACKAGE_shadowsocksr-libev-*
configs_exclude=CONFIG_PACKAGE_trojan-go
configs_exclude=CONFIG_PACKAGE_trojan-plus
configs_exclude=CONFIG_PACKAGE_tuic-client
configs_exclude=CONFIG_PACKAGE_v2ray-plugin
configs_exclude=CONFIG_PACKAGE_xray-plugin
configs_exclude=CONFIG_PACKAGE_v2ray-geoip
configs_exclude=CONFIG_PACKAGE_v2ray-geosite
configs_exclude=CONFIG_PACKAGE_dns2socks
configs_exclude=CONFIG_PACKAGE_dns2tcp
configs_exclude=CONFIG_PACKAGE_ipt2socks
configs_exclude=CONFIG_PACKAGE_chinadns-ng
configs_exclude=CONFIG_PACKAGE_haproxy

# OpenClash 专属运行时
configs_exclude=CONFIG_PACKAGE_ruby
configs_exclude=CONFIG_PACKAGE_ruby-*
configs_exclude=CONFIG_PACKAGE_libruby
configs_exclude=CONFIG_RUBY_ENABLE_YJIT
configs_exclude=CONFIG_PACKAGE_bash
configs_exclude=CONFIG_PACKAGE_unzip

# 仅代理使用过的内核模块与 iptables 兼容层
configs_exclude=CONFIG_PACKAGE_kmod-inet-diag
configs_exclude=CONFIG_PACKAGE_kmod-ipt-nat
configs_exclude=CONFIG_PACKAGE_kmod-ipt-nat6
configs_exclude=CONFIG_PACKAGE_kmod-ipt-conntrack
configs_exclude=CONFIG_PACKAGE_kmod-ipt-core
configs_exclude=CONFIG_PACKAGE_kmod-ipt-extra
configs_exclude=CONFIG_PACKAGE_kmod-ipt-ipopt
configs_exclude=CONFIG_PACKAGE_kmod-ipt-ipset
configs_exclude=CONFIG_PACKAGE_kmod-ipt-physdev
configs_exclude=CONFIG_PACKAGE_kmod-nf-ipt
configs_exclude=CONFIG_PACKAGE_kmod-nf-ipt6
configs_exclude=CONFIG_PACKAGE_ipset
configs_exclude=CONFIG_PACKAGE_libipset

# iptables 用户态（防火墙完全走 firewall4 + nftables 原生语法）
# 说明：内核兼容层 kmod-nft-compat 保留 —— 体积小，且能在 nft 规则里用 xtables 风格匹配
configs_exclude=CONFIG_PACKAGE_iptables-nft
configs_exclude=CONFIG_PACKAGE_iptables-mod-ipopt
