
config easytier
        option enabled '0'
        option easytierbin '/usr/bin/easytier-core'
        option interface_netmask '255.255.255.0'
        option web_enabled '0'
        option webbin '/usr/bin/easytier-web'
        option etcmd 'etcmd'
        option log 'off'
        option et_forward 'etfwlan etfwwan lanfwet wanfwet'
        option network_name ''
        option network_secret ''
        option ipaddr '10.255.255.1'
        list peeradd ''
        list proxy_network '192.168.2.0/24'
        option rpc_portal '15888'
        option listenermode 'ON'
        option tcp_port '11010'
        option ws_port '11011'
        option wss_port '11012'
        option default_protocol 'tcp'
        option encryption_algorithm 'aes-gcm'
        option multi_thread '1'
        option comp 'zstd'
        option proxy_forward '1'
        option private_mode '1'
        option desvice_name 'OpenWrt-k'
        option tunname 'easytier'

