# table inet xray {

    set private {
        type ipv4_addr
        flags interval
        auto-merge
        elements = {
            172.100.100.0/24,
            172.200.200.0/24,
            127.0.0.0/8,
            192.168.0.0/16,
            172.16.0.0/12,
            10.0.0.0/8,
            100.64.0.0/10,
            169.254.0.0/16,
            192.88.99.0/24,
            198.18.0.0/15,
            198.51.100.0/24,
            203.0.113.0/24,
            224.0.0.0/4,
            240.0.0.0/4,
            255.255.255.255/32
        }
    }

    set private6 {
        type ipv6_addr
        flags interval
        auto-merge
        elements = {
            ::/128,
            ::1/128,
            ::ffff:0:0/96,
            100::/64,
            64:ff9b::/96,
            2001::/32,
            2001:10::/28,
            2001:20::/28,
            2001:db8::/32,
            2002::/16,
            fc00::/7,
            fe80::/10,
            ff00::/8
        }
    }

    set direct {
        type ipv4_addr
        flags interval
        auto-merge
        elements = {
            1.1.1.1,
            1.0.0.1
        }
    }

    set direct6 {
        type ipv6_addr
        flags interval
        auto-merge
        elements = {
            2606:4700:4700::1111,
            2606:4700:4700::1001
        }
    }

    include "/etc/nftables.d/cn_ipv4.conf";
    include "/etc/nftables.d/cn_ipv6.conf";

    set myip {
        type ipv4_addr
        flags interval
        auto-merge
    }

    set myip6 {
        type ipv6_addr
        flags interval
        auto-merge
    }

    set vps {
        type ipv4_addr
        flags interval
        auto-merge
    }

    set vps6 {
        type ipv6_addr
        flags interval
        auto-merge
    }

    chain xray_prerouting  {
        type filter hook prerouting priority mangle; policy accept;
        meta mark 0xff counter accept comment "Xray发出的连接"

        meta l4proto { tcp, udp } counter

        meta l4proto != { tcp, udp } counter accept
        th dport 123 counter accept comment "时间同步"
        th dport 53 counter accept comment "DNS"

        iifname "easytier" counter accept comment "easytier"
        oifname "easytier" counter accept comment "easytier"

        ip daddr @myip counter accept comment "公网IP"
        ip6 daddr @myip6 counter accept comment "公网IP"
        ip daddr @private counter accept comment "私有IP"
        ip6 daddr @private6 counter accept comment "私有IP"
        ip daddr @direct counter accept comment "直连IP"
        ip6 daddr @direct6 counter accept comment "直连IP"
        ip daddr @cn_ipv4 counter accept comment "国内IP"
        ip6 daddr @cn_ipv6 counter accept comment "国内IP"

        ip daddr @vps counter accept comment "vps IP"

        meta l4proto { tcp, udp } counter

        meta l4proto { tcp, udp } meta mark set 0x11 tproxy ip to :65535 counter accept comment "Xray"
        meta l4proto { tcp, udp } meta mark set 0x11 tproxy ip6 to :65535 counter accept comment "Xray"

        meta l4proto { tcp, udp } counter
    }

    chain xray_output {
        type route hook output priority filter -10; policy accept;
        meta skgid 966 counter accept comment "Xray发出的连接"

        meta l4proto { tcp, udp } counter

        meta l4proto != { tcp, udp } counter accept
        th dport 123 counter accept comment "时间同步"
        th dport 53 counter accept comment "DNS"

        iifname "easytier" counter accept comment "easytier"
        oifname "easytier" counter accept comment "easytier"

        ip daddr @myip counter accept comment "公网IP"
        ip6 daddr @myip6 counter accept comment "公网IP"
        ip daddr @private counter accept comment "私有IP"
        ip6 daddr @private6 counter accept comment "私有IP"
        ip daddr @direct counter accept comment "直连IP"
        ip6 daddr @direct6 counter accept comment "直连IP"
        ip daddr @cn_ipv4 counter accept comment "国内IP"
        ip6 daddr @cn_ipv6 counter accept comment "国内IP"

        ip daddr @vps counter accept comment "vps IP"

        meta l4proto { tcp, udp } counter

        meta l4proto { tcp, udp } mark set 0x11 counter accept comment "重路由"

        meta l4proto { tcp, udp } counter
    }

    chain xray_divert {
        type filter hook prerouting priority mangle -10; policy accept;
        meta l4proto { tcp, udp } socket transparent 1 meta mark set 0x11 counter accept
    }

#    chain mosdns_dns_prerouting {
#        type nat hook prerouting priority dstnat -10; policy accept;
#        meta nfproto { ipv4, ipv6 } meta l4proto { tcp, udp } th dport 53 counter redirect to :5335 comment "DNS HIJACK"
#    }
#    chain mosdns_dns_output {
#        type nat hook output priority dstnat - 10; policy accept;
#        meta skgid != 967 meta nfproto { ipv4, ipv6 } meta l4proto { tcp, udp } th dport 53 counter redirect to :5335 comment "DNS HIJACK"
#    }
# }
